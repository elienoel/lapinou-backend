# --- Local development defaults ---
DEBUG=True
SECRET_KEY=django-insecure-lapinou-dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# --- Production-only settings (used by docker-compose.prod.yml) ---
# Leave DB_NAME empty to fall back to SQLite (local dev). Set it to use PostgreSQL.
# DB_NAME=lapinou
# DB_USER=lapinou
# DB_PASSWORD=change-me
# DB_HOST=db
# DB_PORT=5432
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# --- Abonnements : paiement GeniusPay ---
# Clés sandbox (pk_sandbox_ / sk_sandbox_) pour les tests, puis live en production.
# GENIUSPAY_API_KEY=pk_sandbox_xxx
# GENIUSPAY_API_SECRET=sk_sandbox_xxx
# Secret renvoyé une seule fois à la création du webhook (whsec_...)
# GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_xxx
# GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
