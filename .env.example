# --- Local development defaults ---
DEBUG=True
SECRET_KEY=django-insecure-lapinou-dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# --- Production-only settings (used by docker-compose.prod.yml) ---
# Leave DB_NAME empty to fall back to SQLite (local dev). Set it to use PostgreSQL.
# DB_NAME=lapinou
# DB_USER=lapinou
# DB_PASSWORD=change-me
# DB_HOST=db
# DB_PORT=5432
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
